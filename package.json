{
  "name": "wikitext-fmt-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based MediaWiki Wikitext formatter powered by wikitext-fmt",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm check:bundle"
  },
  "dependencies": {
    "@bhsd/codemirror-wikitext": "^0.10.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wikiparser-node": "^1.46.2",
    "wikitext-fmt": "0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
