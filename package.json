{
  "name": "wikitext-fmt-web",
  "version": "0.5.0",
  "private": true,
  "description": "Browser-based MediaWiki Wikitext formatter powered by wikitext-fmt",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "check:api-removals": "node scripts/check-api-removals.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check:release-metadata": "node scripts/release-metadata.mjs",
    "check": "pnpm lint && pnpm check:api-removals && pnpm typecheck && pnpm test:run && pnpm build && pnpm check:bundle && pnpm check:metadata"
  },
  "dependencies": {
    "@bhsd/codemirror-wikitext": "^0.12.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/libertinus-serif": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "wikiparser-node": "^1.48.0",
    "wikitext-fmt": "0.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  }
}
